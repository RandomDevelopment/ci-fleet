[Unit]
Description=Drain the ci-fleet deployer before maintenance

[Service]
Type=oneshot
User=root
# Recreate the boot-volatile lock outside the read-only service namespace.
ExecStartPre=+/usr/bin/mkdir -p -m 0700 /var/lock/ci-fleet-deployer
ExecStart=/opt/ci-fleet-deployer/current/scripts/deployer-runtime.sh drain
Environment=CI_FLEET_DEPLOYER_CONFIG=/var/lib/ci-fleet-deployer/active-policy.conf
TimeoutStartSec=2min
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/ci-fleet-deployer /opt/ci-fleet-deployer
ReadWritePaths=/var/lib/ci-fleet-deployer /var/log/ci-fleet-deployer
RestrictSUIDSGID=yes

RuntimeDirectory=ci-fleet-deployer-adapters
RuntimeDirectoryMode=0711
RuntimeDirectoryPreserve=yes
ReadWritePaths=/run/ci-fleet-deployer-adapters /var/lib/ci-fleet-deployer/.adapter-recovery
